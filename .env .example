# ==============================================================================
# PayFlow Environment Configuration (.env.example)
# Copy this file to .env and fill in your genuine sandbox/test credentials.
# NEVER commit .env or real/live keys to GitHub.
# ==============================================================================

# Application
APP_NAME=PayFlow
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-hex-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database
# PostgreSQL (Docker / Production):
# DATABASE_URL=postgresql+psycopg2://payflow:payflow_dev_password@localhost:5432/payflow
# SQLite fallback for quick local development:
DATABASE_URL=sqlite:///./database/payflow.db

# PostgreSQL Container Settings (used by docker-compose.yml)
POSTGRES_DB=payflow
POSTGRES_USER=payflow
POSTGRES_PASSWORD=payflow_dev_password

# ------------------------------------------------------------------------------
# Payment Gateway 1: Stripe Official Sandbox (https://dashboard.stripe.com/test/apikeys)
# ------------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# Payment Gateway 2: Razorpay Official Test Mode (https://dashboard.razorpay.com/app/keys)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_U4Ll8s1thT3t5A
RAZORPAY_KEY_SECRET=tcwUIB0I9Ts8nF3S7O6wfblZ
RAZORPAY_WEBHOOK_SECRET=PayFlow_Webhook_Secure_2005@3112

# Default currency (USD for Stripe international / INR for Razorpay domestic)
DEFAULT_CURRENCY=USD

# ------------------------------------------------------------------------------
# Frontend Vite Public Variables (frontend/.env or passed at build/dev time)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key

# ------------------------------------------------------------------------------
# Automation / Selenium Settings
# ------------------------------------------------------------------------------
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:8000
E2E_HEADLESS=false
E2E_RECORD_VIDEO=true
E2E_BROWSER=chrome
E2E_DEFAULT_GATEWAY=auto
